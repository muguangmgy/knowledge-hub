# JWT 鉴权（Phase 2+）
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# CORS
CORS_ORIGINS=http://localhost:5173

# MySQL
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/knowledge_hub?charset=utf8mb4

# LLM（Phase 4）
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Embedding / 本地存储（Phase 3+）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
KB_DIR=data/kb
CHROMA_DIR=data/chroma

# RAG（Phase 3/4）
INGEST_MAX_MB=50
RAG_TOP_K=8
RAG_REJECT_MAX_DISTANCE=0.55
