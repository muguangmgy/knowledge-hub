# --- BASE ---
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/knowledge_hub?charset=utf8mb4
CORS_ORIGINS=http://localhost:5173
KB_DIR=data/kb
REDIS_URL=

# --- JWT ---
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# --- CHROMA ---
CHROMA_DIR=data/chroma

# --- LLM ---
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# --- EMBEDDING ---
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# --- RERANK ---
# KEY/URL 为空时回落 EMBEDDING_*
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- RAG ---
# 单文件上传上限（MB）
INGEST_MAX_MB=50
# 精排后最终给模型的片段条数
RAG_TOP_K=8
# 向量 / BM25 各路先召回多少条再 RRF 融合
RAG_HYBRID_PATH_TOP_K=20
# RRF 中 BM25 路权重（1.0=与向量等权；>1 更偏关键词命中；本库实测可从 1.0 微调）
RAG_RRF_BM25_WEIGHT=1.0
# 精排软地板：低于此分视为噪声（约 0~1）
RAG_RERANK_MIN_SCORE=0.05
# 精排相对落差：须 ≥ Top1分数×该比例，否则丢掉
RAG_RERANK_RELATIVE_RATIO=0.5
# 滤完为空时，Top1≥此值则至少保留 Top1，避免短问误拒答
RAG_RERANK_KEEP_TOP1_FLOOR=0.15
# 向量距离上限（仅 filter_relevant 调试用；正式问答以精排分数为准）
RAG_REJECT_MAX_DISTANCE=0.55
# 与 Top1 距离差过大则丢（同上，调试用）
RAG_RELATIVE_MAX_GAP=0.15

# --- 投研助手发信（mode=direct）---
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
# 话术未写具体邮箱时的默认收件人
RESEARCH_DEFAULT_EMAIL=
# 图内 + 外层线程池超时（秒）；前端 Axios 建议 120s
RESEARCH_GRAPH_TIMEOUT_SEC=90
